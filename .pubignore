# Publish only CLI sources and public package documentation. Keep local runner
# installations, credentials, tests, tooling, and development files out even
# when new directories are added to the checkout.
/*
!/bin/
/bin/*
!/bin/onepub.dart
/bin/onepub
/bin/opub
!/lib/
!/example/
!/pubspec.yaml
!/README.md
!/CHANGELOG.md
!/LICENSE
!/SECURITY.md
